		<link rel="icon" type="image/png" href="https://florent.courtay.net/user/themes/antimatter/images/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<meta name="generator" content={Astro.generator} />
		<title>Florent Courtay - Resume</title>
		<meta name="description" content="Florent Courtay - Resume" />
	</head>
	<body>
